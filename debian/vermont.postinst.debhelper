if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'vermont.service'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'vermont.service' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'vermont.service'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'vermont.service' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'vermont.service' >/dev/null || true
fi
